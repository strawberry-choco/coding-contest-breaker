import sys


def parse_input(text: str):
    # TODO: parse the input into the model the validator/scorer needs.
    return text


def validate(problem, answer: str) -> tuple[bool, str]:
    """Return (ok, reason). MUST reject any answer violating the constraints."""
    # TODO: implement validity checks (feasibility, format, limits).
    return True, "valid"


def score(problem, answer: str) -> float:
    """Return the metric value. Only called when the answer is valid."""
    # TODO: implement the objective. Example: total cost, path length, size.
    return 0.0


def main(argv: list[str]) -> int:
    if len(argv) < 3:
        print("usage: scorer.py <input> <output>", file=sys.stderr)
        return 2
    problem = parse_input(open(argv[1], encoding="utf-8").read())
    answer = open(argv[2], encoding="utf-8").read()

